{
  "name": "yello-desktop-app",
  "productName": "Yello",
  "version": "0.4.0",
  "description": "Yello desktop client — Electron + React shell built on the Luminous Minimalist design system.",
  "private": true,
  "author": "Yello <hushstack168@gmail.com>",
  "desktopName": "com.yello.desktop",
  "license": "UNLICENSED",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:local": "YELLO_API_TARGET=local tsx scripts/dev.ts",
    "build": "npm run typecheck && vite build && tsx scripts/build-electron.ts",
    "package": "npm run build && electron-builder",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "version:bump": "tsx scripts/bump-version.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "axios": "1.20.0",
    "electron-updater": "6.8.9",
    "lucide-react": "1.41.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.3",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2"
  }
}
