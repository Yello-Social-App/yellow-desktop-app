<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Required by Electron's JIT under the hardened runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Outbound network access for the API client. No inbound server. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Microphone, for recording voice messages in chat. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Everything else stays denied: no camera, location, address book, or
         unsigned-executable-memory entitlements. -->
  </dict>
</plist>
